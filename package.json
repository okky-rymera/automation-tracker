{
  "name": "automation-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch server/index.ts\" \"vite\"",
    "server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "project": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/cli.ts",
    "check-parsers": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/check-parsers.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "@cucumber/gherkin": "^43.0.0",
    "@cucumber/messages": "^35.0.0",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
